# ==========================================
# PathFinder ? Environment Configuration Template
# ==========================================

# --- Backend Configuration ---
PROJECT_NAME="PathFinder API"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL="sqlite:///./pathfinder.db"

# --- AI Provider Configuration ---
# AI_PROVIDER: "gemini" or "deterministic"
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_INPUT_CHARS=4000
AI_MAX_CONTEXT_ITEMS=10

# --- Vector & Embedding Service ---
EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_MODEL_VERSION="v1.0"
EMBEDDING_DIM=128

# --- Algorithm Version ---
RECOMMENDATION_ALGO_VERSION="v1.2.0"

# --- CORS Allowed Origins (JSON Array) ---
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000", "https://yourdomain.com"]'

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
